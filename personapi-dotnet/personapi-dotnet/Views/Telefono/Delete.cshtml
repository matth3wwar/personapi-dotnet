@model personapi_dotnet.Models.Entities.Telefono
@{
    ViewData["Title"] = "Eliminar teléfono";
}
<h1>Eliminar teléfono</h1>
<p>¿Confirma que desea eliminar el teléfono <strong>@Model.Num</strong> (@Model.Oper) de la persona <strong>@Model.Dueno</strong>?</p>
<form asp-action="Delete" asp-route-id="@Model.Num" method="post">
    <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
