@model personapi_dotnet.Models.Entities.Persona
@{
    ViewData["Title"] = "Detalle de persona";
}
<h1>Detalle de persona</h1>
<dl class="row"><dt class="col-sm-3">Identificación</dt><dd class="col-sm-9">@Model.Cc</dd><dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd><dt class="col-sm-3">Apellido</dt><dd class="col-sm-9">@Model.Apellido</dd><dt class="col-sm-3">Género</dt><dd class="col-sm-9">@Model.Genero</dd><dt class="col-sm-3">Edad</dt><dd class="col-sm-9">@Model.Edad</dd></dl>
<a asp-action="Edit" asp-route-id="@Model.Cc" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-secondary">Volver</a>
