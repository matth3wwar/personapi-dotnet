@model personapi_dotnet.Models.Entities.Persona
@{
    ViewData["Title"] = "Editar persona";
    ViewData["EsEdicion"] = true;
}
<h1>Editar persona</h1>
<form asp-action="Edit" asp-route-id="@Model.Cc" method="post">
    <input type="hidden" asp-for="Cc" />
    <dl class="row">
        <dt class="col-sm-3">Identificación</dt><dd class="col-sm-9">@Model.Cc</dd>
    </dl>
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
